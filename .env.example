# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pricehunt"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# AUTH
# ============================================
JWT_SECRET="dev-jwt-secret-change-in-production-minimum-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="dev-refresh-token-secret-change-in-production-32"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ============================================
# APP
# ============================================
NODE_ENV="development"
PORT=3001
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:3000"

# ============================================
# PAYMENTS (Conekta) - Get from https://developers.conekta.com
# ============================================
CONEKTA_PRIVATE_KEY=""
CONEKTA_PUBLIC_KEY=""
CONEKTA_WEBHOOK_SECRET=""

# ============================================
# AI (OpenAI) - Get from https://platform.openai.com
# ============================================
OPENAI_API_KEY=""

# ============================================
# EMAIL (Resend) - Get from https://resend.com
# ============================================
RESEND_API_KEY=""
EMAIL_FROM="PriceHunt <noreply@pricehunt.mx>"

# ============================================
# STORAGE (Cloudflare R2) - Get from https://dash.cloudflare.com
# ============================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="pricehunt-images"
R2_PUBLIC_URL=""

# ============================================
# MONITORING (Sentry) - Get from https://sentry.io
# ============================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
