{
  "name": "@pricehunt/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@pricehunt/shared": "workspace:*",
    "drizzle-orm": "^0.35.0",
    "meilisearch": "^0.41.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.25.0",
    "tsx": "^4.7.0",
    "vitest": "^4.1.11",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
